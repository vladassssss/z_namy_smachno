<?php
// Перевірка, чи відправлена форма
if ($_SERVER["REQUEST_METHOD"] === "POST") {
    // Отримуємо дані з форми
    $name = htmlspecialchars($_POST['name']);
    $email = htmlspecialchars($_POST['email']);
    $question1 = htmlspecialchars($_POST['question1']);
    $question2 = htmlspecialchars($_POST['question2']);
    $question3 = htmlspecialchars($_POST['question3']);
    $timestamp = date('Y-m-d H:i:s');

    // Створюємо папку "survey", якщо вона не існує
    $surveyFolder = "survey";
    if (!file_exists($surveyFolder)) {
        mkdir($surveyFolder, 0777, true);
    }

    // Формуємо вміст файлу
    $fileContent = "Ім'я: $name\n";
    $fileContent .= "Email: $email\n";
    $fileContent .= "Оцінка рецепту: $question1\n";
    $fileContent .= "Пропозиції: $question2\n";
    $fileContent .= "Чи порадить рецепт: $question3\n";
    $fileContent .= "Дата та час: $timestamp\n";

    // Генеруємо ім'я файлу
    $fileName = $surveyFolder . "/survey_" . date('Y-m-d_H-i-s') . ".txt";

    // Зберігаємо дані у файл
    file_put_contents($fileName, $fileContent);

    // Виводимо підтвердження
    echo "<h1>Дякуємо за ваш відгук!</h1>";
    echo "<p>Дата та час відправлення: $timestamp</p>";
    echo "<p>Ваші відповіді успішно збережені.</p>";
} else {
    echo "<h1>Форма не відправлена.</h1>";
}
?>

